{
  "name": "End-of-Life Component Gate (public)",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "organization_name": {
      "include": ["catch-oss"],
      "exclude": []
    },
    "repository_name": {
      "include": ["*"],
      "exclude": ["integration__*"]
    },
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/release/*",
        "refs/heads/v*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": true,
        "workflows": [
          {
            "repository_id": 0,
            "path": ".github/workflows/eol-component-gate.yml",
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "EnterpriseOwner",
      "bypass_mode": "always"
    }
  ]
}
